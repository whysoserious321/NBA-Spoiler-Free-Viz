# Everything the refresh writes stays local, except the saved game days and
# the shot data for the hot zones (this season's per-day files and the earlier
# seasons): they are committed with the code, so GitHub keeps a backup of them.
# The season index (shots/<year>/index.json) is rebuilt from the day files.
data/*
!data/snapshots/
data/snapshots/.tmp_*
!data/cache/
data/cache/*
!data/cache/shots/
data/cache/shots/*
!data/cache/shots/past/
data/cache/shots/past/.tmp_*
!data/cache/shots/[0-9][0-9][0-9][0-9]/
data/cache/shots/[0-9][0-9][0-9][0-9]/*
!data/cache/shots/[0-9][0-9][0-9][0-9]/days/
data/cache/shots/[0-9][0-9][0-9][0-9]/days/.tmp_*
__pycache__/
*.pyc
*.log
*.out
